# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rift
POSTGRES_OPTIONS=
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_CONNECT_TIMEOUT_SECONDS=30
POSTGRES_IDLE_TIMEOUT_SECONDS=600
POSTGRES_MAX_LIFETIME_SECONDS=1800

# Database per service. Each service connects to its own database with its own
# role, creates its schema and runs the migrations from
# backend/services/<service>/migrations on start. <SERVICE>_POSTGRES_DB, _USER
# and _PASSWORD override the shared POSTGRES_* values for that service; unset
# ones fall back to them. docker-compose creates these databases and roles on a
# fresh volume via docker/postgres/initdb. livekit-pooler uses the messaging
# database, and outbox-worker relays the outboxes listed in OUTBOX_SOURCES.
IDENTITY_POSTGRES_DB=rift_identity
IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=identity
MEDIA_POSTGRES_DB=rift_media
MEDIA_POSTGRES_USER=media
MEDIA_POSTGRES_PASSWORD=media
MESSAGING_POSTGRES_DB=rift_messaging
MESSAGING_POSTGRES_USER=messaging
MESSAGING_POSTGRES_PASSWORD=messaging
VOICE_POSTGRES_DB=rift_voice
VOICE_POSTGRES_USER=voice
VOICE_POSTGRES_PASSWORD=voice
REALTIME_POSTGRES_DB=rift_realtime
REALTIME_POSTGRES_USER=realtime
REALTIME_POSTGRES_PASSWORD=realtime
OUTBOX_SOURCES=identity,messaging,voice

# Server (http)
HOST=0.0.0.0
PORT=8080
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-characters
TRUST_FORWARDED_HEADERS=false
RATE_LIMITING_REQUESTS=10
RATE_LIMITING_BURST_SIZE=60
ALTCHA_HMAC_KEY=change-this-to-another-long-random-string-at-least-32-characters
ALTCHA_MAX_NUMBER=50000
INTERNAL_API_TOKEN=change-this-to-a-shared-secret-for-service-to-service-calls
CORS_ALLOWED_ORIGINS=
TRIAL_HASH_KEY=change-this-to-a-third-long-random-string-and-never-rotate-it

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://livekit:7880
LIVEKIT_CLIENT_URL=ws://localhost:7880

# Google OAuth (Sign in with Google)
# Comma-separated list of accepted ID-token audiences (client IDs). Include the
# Web client ID (web GIS) and the Desktop client ID (Electron loopback flow).
# Leave empty to disable Google login (endpoint returns GOOGLE_NOT_CONFIGURED).
GOOGLE_CLIENT_ID=

# NATS
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=rift.events
NATS_REPLICAS=1

# Mailer (smtp_mailer)
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USERNAME=user
MAILER_PASSWORD=password
MAILER_FROM=noreply@example.com
MAILER_PASSWORD_RESET_BASE_URL=https://example.com/reset

# Notification service
NOTIFICATION_USER_STREAM=RIFT_USER_EVENTS
NOTIFICATION_VERIFICATION_CONSUMER=notification-service-verification
NOTIFICATION_MAX_DELIVER=5

# Outbox worker
OUTBOX_BATCH_SIZE=100
OUTBOX_IDLE_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=50
OUTBOX_BACKOFF_BASE_SECS=5
OUTBOX_BACKOFF_MAX_MULTIPLIER=10
OUTBOX_CLEANUP_INTERVAL_SECS=3600
OUTBOX_CLEANUP_RETENTION_SECS=604800
OUTBOX_CLEANUP_BATCH_SIZE=10000

# Websocket gateway (WS connections, fanout via NATS core)
BIND_ADDRESS=0.0.0.0:8083
WEBSOCKET_HEALTH_PORT=8084
WEBSOCKET_OUTBOUND_BUFFER=64

# Event dispatcher (JetStream -> NATS core fanout)
DISPATCHER_HEALTH_PORT=8085
DISPATCHER_USER_STREAM=RIFT_USER_EVENTS
DISPATCHER_CHANNEL_STREAM=RIFT_CHANNEL_EVENTS
DISPATCHER_MESSAGE_STREAM=RIFT_MESSAGE_EVENTS
DISPATCHER_DM_MESSAGE_STREAM=RIFT_DM_MESSAGE_EVENTS
DISPATCHER_COMMUNITY_STREAM=RIFT_COMMUNITY_EVENTS
DISPATCHER_CONSUMER_PREFIX=event-dispatcher
DISPATCHER_MAX_DELIVER=10

# Logging
RUST_LOG=info

# MinIO (attachment storage). The same credentials are passed to both the
# MinIO container and the HTTP service; override them together via this file.
MINIO_ROOT_USER=rift
MINIO_ROOT_PASSWORD=rift-minio-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=rift-attachments

# NSFW image moderation (self-hosted detector container).
# Leave NSFW_DETECTOR_URL empty to disable content moderation entirely;
# when set, uploads are rejected while the detector is unreachable (fail-closed).
NSFW_DETECTOR_URL=http://nsfw-detector:8000
NSFW_THRESHOLD=0.8

# Username content moderation (same detector container, text endpoint).
# Fail-closed: usernames failing the check are rejected with NAME_NOT_ALLOWED,
# and while the detector is unreachable (or runs an older image without the
# text endpoint) registration and rename are rejected with MODERATION_UNAVAILABLE.
# The only way to skip the check is to disable moderation entirely by setting
# NSFW_DETECTOR_URL to an empty string.
TEXT_TOXICITY_THRESHOLD=0.8
# Comma-separated extra reserved usernames on top of the built-in list.
RESERVED_USERNAMES=


# Unverified account cleanup (identity-service). Registration takes the login
# and the email before the code is confirmed, so accounts that are never
# confirmed are deleted after UNVERIFIED_ACCOUNT_TTL_HOURS and give both back.
# Deletion follows the same path as deleting an account by hand: the row stays,
# the login is renamed, and every service is told through the outbox.
# Accounts created with Google are verified on sign-up and are never touched.
UNVERIFIED_CLEANUP_ENABLED=true
UNVERIFIED_ACCOUNT_TTL_HOURS=24
UNVERIFIED_CLEANUP_INTERVAL_SECS=900
UNVERIFIED_CLEANUP_BATCH_SIZE=200


# Shared rate limiting. When REDIS_URL is set, all API replicas enforce a
# single GCRA limit per user in Redis; when empty, each replica falls back to
# an in-memory limiter.
REDIS_URL=redis://redis:6379

# Health probes: per-probe timeout and result cache used by /readyz.
HEALTH_PROBE_TIMEOUT_MS=2000
HEALTH_PROBE_CACHE_MS=5000

# Liveness heartbeats for worker loops: /livez turns 503 when a loop has not
# ticked for longer than the threshold.
OUTBOX_LIVENESS_STALE_SECS=60
LIVEKIT_POOLER_LIVENESS_STALE_SECS=120
NOTIFICATION_LIVENESS_STALE_SECS=60
DISPATCHER_LIVENESS_STALE_SECS=30

# Graceful shutdown: on SIGTERM/SIGINT a service flips /readyz to 503, waits
# SHUTDOWN_DRAIN_MS for load balancers to notice, then stops accepting and gives
# in-flight requests up to SHUTDOWN_TIMEOUT_SECS to finish.
SHUTDOWN_DRAIN_MS=3000
SHUTDOWN_TIMEOUT_SECS=25
# Compose waits this long before SIGKILL; keep it above SHUTDOWN_DRAIN_MS +
# SHUTDOWN_TIMEOUT_SECS plus a few seconds of margin.
STOP_GRACE_PERIOD=35s
