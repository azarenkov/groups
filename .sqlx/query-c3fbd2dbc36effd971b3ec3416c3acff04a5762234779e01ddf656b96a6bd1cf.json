{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT m.id, m.channel_id, m.author_id, u.name AS author_name,\n                       m.content, m.created_at, m.edited_at\n                FROM messages m\n                INNER JOIN users u ON u.id = m.author_id\n                WHERE m.channel_id = $1\n                ORDER BY m.created_at DESC, m.id DESC\n                LIMIT $2\n                ",
