  "query": "\n            UPDATE attachments\n            SET claimed_at = now(), claim_token = $3\n            WHERE id = ANY($1) AND owner_id = $2\n              AND claimed_at IS NULL AND deleting_at IS NULL\n            RETURNING id, owner_id, file_name, content_type, size_bytes, storage_key, created_at\n            ",
