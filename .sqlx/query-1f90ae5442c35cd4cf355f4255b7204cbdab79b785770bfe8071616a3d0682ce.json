  "query": "\n            SELECT s.id, s.name, s.accent_color\n            FROM servers s\n            INNER JOIN server_members a ON a.server_id = s.id AND a.user_id = $1\n            INNER JOIN server_members b ON b.server_id = s.id AND b.user_id = $2\n            ORDER BY s.name ASC\n            ",
