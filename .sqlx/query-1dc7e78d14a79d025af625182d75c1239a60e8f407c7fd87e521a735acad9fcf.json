  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    server_id,\n                    owner_id,\n                    name,\n                    max_participants,\n                    channel_type as \"channel_type: ChannelTypeDto\",\n                    password_hash,\n                    created_at,\n                    updated_at,\n                    last_join\n                FROM channels\n                WHERE server_id = $1\n                ORDER BY created_at DESC\n                LIMIT $2 OFFSET $3\n            ",
