  "query": "\n            SELECT\n                id,\n                aggregate_id,\n                aggregate_type AS \"aggregate_type: AggregateTypeDto\",\n                parent_id,\n                parent_type AS \"parent_type: AggregateTypeDto\",\n                event_type,\n                payload,\n                occurred_at\n            FROM outbox\n            WHERE processed_at IS NULL\n            ORDER BY created_at\n            FOR UPDATE SKIP LOCKED\n            LIMIT 1\n            ",
