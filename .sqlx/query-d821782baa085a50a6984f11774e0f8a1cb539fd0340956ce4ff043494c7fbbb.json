  "query": "\n            SELECT\n                id, server_id, owner_id, name,\n                kind as \"kind: ChannelKindDto\",\n                visibility as \"visibility: ChannelVisibilityDto\",\n                password_hash, created_at, updated_at, last_join\n            FROM channels\n            WHERE server_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
