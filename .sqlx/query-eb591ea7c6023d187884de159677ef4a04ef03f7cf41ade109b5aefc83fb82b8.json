  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    user_id,\n                    channel AS \"channel: VerificationChannelDto\",\n                    code_hash,\n                    purpose AS \"purpose: VerificationPurposeDto\",\n                    expires_at,\n                    consumed_at,\n                    attempts,\n                    created_at\n                FROM verification_codes\n                WHERE user_id = $1 AND consumed_at IS NULL\n                ORDER BY created_at DESC\n                LIMIT 1\n                FOR UPDATE\n            ",
