{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, channel_id, author_id, content, created_at, edited_at\n                FROM messages\n                WHERE channel_id = $1\n                  AND (created_at, id) > (\n                      SELECT created_at, id FROM messages\n                      WHERE id = $2 AND channel_id = $1\n                  )\n                ORDER BY created_at ASC, id ASC\n                LIMIT $3\n                ",
