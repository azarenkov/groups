{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT u.id, u.name, u.email, u.password_hash, u.created_at, u.updated_at\n                FROM users u\n                INNER JOIN server_members sm ON sm.user_id = u.id\n                WHERE sm.server_id = $1\n                ORDER BY sm.joined_at ASC\n                LIMIT $2 OFFSET $3\n            ",
