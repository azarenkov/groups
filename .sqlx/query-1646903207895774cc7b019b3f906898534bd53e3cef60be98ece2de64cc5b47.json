{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    f.user_id, f.friend_id,\n                    f.status AS \"status: FriendshipStatusDto\",\n                    u.name AS friend_name,\n                    f.created_at, f.updated_at\n                FROM friendships f\n                INNER JOIN users u ON u.id = f.friend_id\n                WHERE f.user_id = $1\n                ORDER BY f.updated_at DESC\n                ",
