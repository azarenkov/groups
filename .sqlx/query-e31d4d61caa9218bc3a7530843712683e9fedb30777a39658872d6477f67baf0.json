{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id, channel_id, author_id, content, created_at, edited_at\n                    FROM messages\n                    WHERE channel_id = $1\n                      AND (created_at, id) < ($2, $3)\n                    ORDER BY created_at DESC, id DESC\n                    LIMIT $4\n                    ",
