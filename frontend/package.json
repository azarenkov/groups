{
  "name": "rift-desktop",
  "version": "0.1.9",
  "description": "Rift - Discord-like voice chat application",
  "author": {
    "name": "Rift",
    "email": "support@rift.app"
  },
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ort-wasm.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/write-desktop-config.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron:dev": "concurrently \"BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "test:ci": "react-scripts test --watchAll=false"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.8.3",
    "fft.js": "^4.0.4",
    "framer-motion": "^10.16.16",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "livekit-client": "^2.17.2",
    "onnxruntime-web": "^1.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.rift.desktop",
    "protocols": [
      {
        "name": "Rift",
        "schemes": [
          "rift"
        ]
      }
    ],
    "productName": "Rift",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/splash.html",
      "public/icons/**/*",
      "public/worklets/**/*",
      "public/models/**/*",
      "public/ort/**/*"
    ],
    "directories": {
      "buildResources": "public/icons"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rift-space",
        "repo": "rift-releases"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "public/icons/rift-icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/icons/rift-icon-256.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "public/icons/rift-icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
