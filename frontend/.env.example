# API Configuration
REACT_APP_API_URL=http://localhost:8080/api

# WebSocket endpoint (auto-derived from API_URL if omitted: http→ws, /api→/ws)
# REACT_APP_WS_URL=ws://localhost:8080/ws

# Application Settings
REACT_APP_NAME=Rift
REACT_APP_VERSION=0.1.0

# Development Settings
BROWSER=none
PORT=3000

# LiveKit Configuration
REACT_APP_LIVEKIT_URL=http://localhost:7880

# Google OAuth (Sign in with Google). Leave empty to hide the Google button.
# Get a Web client ID from Google Cloud Console → APIs & Services → Credentials.
# IMPORTANT: the backend must be given the SAME id via GOOGLE_CLIENT_ID
# (env/http.env), otherwise /v1/auth/google rejects logins with
# GOOGLE_NOT_CONFIGURED and the visible button won't work.
REACT_APP_GOOGLE_CLIENT_ID=
