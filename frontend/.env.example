# API Configuration
REACT_APP_API_URL=http://localhost:8080/api

# WebSocket endpoint (auto-derived from API_URL if omitted: http→ws, /api→/ws)
# REACT_APP_WS_URL=ws://localhost:8080/ws

# Public web app origin for shared message links (desktop builds; the web build uses the page origin)
# REACT_APP_PUBLIC_APP_URL=https://rift.example

# Application Settings
REACT_APP_NAME=Rift
REACT_APP_VERSION=0.1.0

# Development Settings
BROWSER=none
PORT=3000

# LiveKit Configuration
REACT_APP_LIVEKIT_URL=http://localhost:7880

# Google OAuth (Sign in with Google) — WEB build.
# Web client ID from Google Cloud Console → Credentials (authorized JS origin =
# your web origin). Leave empty to hide the button on web.
# The backend GOOGLE_CLIENT_ID must include this id, else /v1/auth/google
# rejects logins with GOOGLE_NOT_CONFIGURED.
REACT_APP_GOOGLE_CLIENT_ID=

# Google OAuth — DESKTOP (Electron) build, native loopback + PKCE flow.
# Use a "Desktop app" OAuth client (its secret is non-confidential for installed
# apps). At `npm run build` these are baked into build/desktop-config.json and
# shipped by electron-builder; the Electron main process also reads them from the
# environment in dev. The backend GOOGLE_CLIENT_ID must include this client ID.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
