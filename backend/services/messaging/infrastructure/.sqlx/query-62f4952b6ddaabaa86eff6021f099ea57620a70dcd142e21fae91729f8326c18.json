  "query": "WITH revoked AS (UPDATE community_invite_links SET revoked_at = now() WHERE token = $1 AND community_id = $2 AND revoked_at IS NULL AND (created_by = $3 OR $4) RETURNING *) SELECT l.token, l.community_id, l.created_by, u.name AS creator_name, l.name, l.is_primary, l.max_uses, l.uses, l.expires_at, l.created_at, l.revoked_at FROM revoked l LEFT JOIN messaging_user_profiles u ON u.user_id = l.created_by",
