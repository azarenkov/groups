{
  "db_name": "PostgreSQL",
  "query": "SELECT l.token, l.community_id, l.created_by, u.name AS creator_name, l.name, l.is_primary, l.max_uses, l.uses, l.expires_at, l.created_at, l.revoked_at FROM community_invite_links l LEFT JOIN messaging_user_profiles u ON u.user_id = l.created_by WHERE l.community_id = $1 AND NOT l.is_primary AND l.revoked_at IS NULL AND (l.expires_at IS NULL OR l.expires_at > now()) AND (l.max_uses IS NULL OR l.uses < l.max_uses) AND ($2::timestamptz IS NULL OR (l.created_at, l.token) < ($2, $3::text)) ORDER BY l.created_at DESC, l.token DESC LIMIT $4",
