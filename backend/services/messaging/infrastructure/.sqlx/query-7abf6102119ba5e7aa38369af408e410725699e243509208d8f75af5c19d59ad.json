{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT s.id, s.name, s.owner_id, s.description, s.accent_color,\n                       s.created_at, s.updated_at\n                FROM communities s\n                INNER JOIN community_members sm ON sm.community_id = s.id\n                WHERE sm.user_id = $1\n                ORDER BY s.created_at DESC\n                LIMIT $2 OFFSET $3\n            ",
