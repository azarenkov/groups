  "query": "\n            SELECT user_id, tier, badge_style, member_number, emoji_status_sticker_id, emoji_status_until\n            FROM messaging_user_profiles\n            WHERE user_id = ANY($1)\n              AND active\n              AND tier <> 'free'\n              AND (tier_valid_until IS NULL OR tier_valid_until > $2)\n            ",
