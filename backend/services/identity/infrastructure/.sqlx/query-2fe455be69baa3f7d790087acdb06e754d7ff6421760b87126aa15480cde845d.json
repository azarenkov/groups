{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                MAX(created_at) AS last_issued_at,\n                MIN(created_at) FILTER (WHERE created_at > $3) AS oldest_in_window,\n                COUNT(*) FILTER (WHERE created_at > $3) AS \"issued_last_hour!\"\n            FROM verification_codes\n            WHERE user_id = $1 AND purpose = $2\n            ",
  "describe": {
    "columns": [
      {
        "ordinal": 0,
        "name": "last_issued_at",
        "type_info": "Timestamptz"
      },
      {
        "ordinal": 1,
        "name": "oldest_in_window",
        "type_info": "Timestamptz"
      },
      {
        "ordinal": 2,
        "name": "issued_last_hour!",
        "type_info": "Int8"
      }
    ],
    "parameters": {
      "Left": [
        "Uuid",
        {
          "Custom": {
