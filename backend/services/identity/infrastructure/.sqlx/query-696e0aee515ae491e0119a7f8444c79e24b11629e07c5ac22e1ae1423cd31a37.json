  "query": "\n            SELECT MAX(created_at) AS last_issued_at, COUNT(*) FILTER (WHERE created_at > $3) AS \"issued_last_hour!\"\n            FROM verification_codes\n            WHERE user_id = $1 AND purpose = $2\n            ",
