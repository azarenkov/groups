worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    server_tokens off;

    client_max_body_size 16m;
    client_body_timeout 30s;
    client_header_timeout 10s;
    send_timeout 30s;
    large_client_header_buffers 4 8k;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /dev/stdout main;
    error_log /dev/stderr warn;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=${NGINX_RESOLVER_IPV6};
    resolver_timeout 5s;
    __NGINX_REAL_IP__

    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=invites:10m rate=30r/m;
    limit_conn_zone $binary_remote_addr zone=perip:10m;
    limit_req_status 429;
    limit_conn_status 429;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $request_method $attachments_upstream {
        default http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
        POST    http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
        DELETE  http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
    }

    server {
        listen 8080 default_server;
        server_name _;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

        limit_conn perip 20;

        if ($request_method !~ ^(GET|HEAD|POST|PUT|DELETE|OPTIONS|PATCH)$) {
            return 405;
        }

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Rift-Internal-Token "";
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;

        location ~ /\.(env|git|htaccess|svn|DS_Store) {
            deny all;
            access_log off;
        }
        location ~ \.(bak|swp|sql|backup|old|orig|save)$ {
            deny all;
            access_log off;
        }
        location ~ /(wp-admin|wp-login|admin\.php|phpmyadmin|xmlrpc\.php) {
            deny all;
            access_log off;
        }

        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        location = /ws {
            set $upstream_ws http://realtime.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8083;
            proxy_pass $upstream_ws;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Rift-Internal-Token "";
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_buffering off;
        }

        location = /presence {
            limit_req zone=api burst=60 nodelay;
            set $upstream_ws http://realtime.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8083;
            proxy_pass $upstream_ws;
        }

        location = /api/v1/presence {
            limit_req zone=api burst=60 nodelay;
            set $upstream_ws http://realtime.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8083;
            rewrite ^/api/v1/presence$ /presence break;
            proxy_pass $upstream_ws;
        }

        location ~ ^/api/v1/auth/(login|register|refresh|request_verification_code|password/forgot|password/reset)$ {
            limit_req zone=api burst=60 nodelay;
            limit_req zone=auth burst=5 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location /api/v1/invites/ {
            limit_req zone=api burst=60 nodelay;
            limit_req zone=invites burst=10 nodelay;
            set $upstream_messaging http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_messaging;
        }

        location /api/v1/auth/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location = /api/v1/users/me {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location = /api/v1/users/search {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location = /api/v1/users/me/locale {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location = /api/v1/users/me/name {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/password {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/disable {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/profile {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/email/change {
            limit_req zone=api burst=60 nodelay;
            limit_req zone=auth burst=5 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location ^~ /api/v1/users/me/email/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location = /api/v1/users/me/voice {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/notifications {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/hotkeys {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/appearance {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/emoji-status {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/users/me/presence {
            limit_req zone=api burst=10 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }
        location = /api/v1/me/presence {
            limit_req zone=api burst=10 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_method PUT;
            rewrite ^/api/v1/me/presence$ /api/v1/users/me/presence break;
            proxy_pass $upstream_identity;
        }
        location ^~ /api/v1/link-previews/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_identity http://identity-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_identity;
        }

        location ~ ^/api/v1/users/[^/]+/avatar$ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_media http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_media;
        }

        location ~ ^/api/v1/users/[^/]+/banner$ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_media http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_media;
        }

        location ~ ^/api/v1/communities/[^/]+/logo$ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_media http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_media;
        }

        location ~ ^/api/v1/sticker-packs/[^/]+/report$ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_messaging http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_messaging;
        }

        location /api/v1/sticker-packs {
            limit_req zone=api burst=60 nodelay;
            client_max_body_size 5m;
            set $upstream_media http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_media;
        }
        location /api/v1/stickers/ {
            limit_req zone=api burst=120 nodelay;
            set $upstream_media http://media-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_media;
        }
        location /api/v1/attachments {
            limit_req zone=api burst=60 nodelay;
            client_max_body_size 512m;
            proxy_request_buffering off;
            proxy_http_version 1.1;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
            client_body_timeout 3600s;
            proxy_pass $attachments_upstream;
        }

        location = /api/v1/calls/log {
            limit_req zone=api burst=60 nodelay;
            set $upstream_messaging http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_messaging;
        }

        location /api/v1/calls {
            limit_req zone=api burst=60 nodelay;
            set $upstream_voice http://voice-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_voice;
        }

        location /api/v1/voice/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_voice http://voice-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_voice;
        }

        location /api/webhook/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_voice http://voice-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_voice;
        }

        location /api/ {
            limit_req zone=api burst=60 nodelay;
            set $upstream_messaging http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_messaging;
        }

        location /internal/ {
            return 404;
        }

        location / {
            set $upstream_messaging http://messaging-service.${NGINX_NAMESPACE}.svc.${NGINX_CLUSTER_DOMAIN}:8080;
            proxy_pass $upstream_messaging;
        }
    }

    server {
        listen 7880 default_server;
        server_name _;

        limit_conn perip 20;

        location / {
            set $upstream_livekit ${NGINX_LIVEKIT_UPSTREAM};
            proxy_pass $upstream_livekit;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Rift-Internal-Token "";
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_buffering off;
        }
    }
}
